# ==============================================================

EbN0_dB = np.arange(
    0,
    21,
    2
)

Nsymbols = 30000

BER_results = {}
SER_results = {}

print("\n================================================")
print("BER / SER SIMULATION")
print("================================================")

for name in modulations:

    BER_list = []
    SER_list = []

    print("\nProcessing", name)

    for snr in EbN0_dB:

        BER, SER = simulate_errors(
            name,
            snr,
            Nsymbols
        )

        BER_list.append(BER)
        SER_list.append(SER)

        print(
            f"Eb/N0 = {snr:2d} dB  "
            f"BER = {BER:.6f}  "
            f"SER = {SER:.6f}"
        )

    BER_results[name] = np.array(BER_list)
    SER_results[name] = np.array(SER_list)


