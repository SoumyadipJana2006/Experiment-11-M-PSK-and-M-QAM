# ==============================================================
# EXPERIMENT 11: M-PSK AND M-QAM
# ==============================================================
# Modulations:
#   1. QPSK
#   2. 8-PSK
#   3. 16-QAM
#   4. 64-QAM
#
# Required plots:
#   1. Ideal / received constellations
#   2. Decision regions
#   3. BER and SER
#   4. BER versus spectral efficiency
#
# Detection:
#   Minimum Euclidean distance
#
# Channel:
#   AWGN
# ==============================================================

import numpy as np
import matplotlib.pyplot as plt

np.random.seed(10)


# ==============================================================
# 1. GRAY CODE
# ==============================================================

def binary_to_gray(n):
    return n ^ (n >> 1)


# ==============================================================
# 2. GENERATE M-PSK CONSTELLATION
# ==============================================================

def create_psk(M):

    k = int(np.log2(M))

    # Symbol phases
    phase = 2 * np.pi * np.arange(M) / M

    constellation = np.exp(1j * phase)

    # Gray labels around the constellation
    labels = np.array([binary_to_gray(i) for i in range(M)])

    # Average energy before normalization
    energy_before = np.mean(np.abs(constellation) ** 2)

    # Normalize to Es = 1
    constellation = constellation / np.sqrt(energy_before)

    energy_after = np.mean(np.abs(constellation) ** 2)

    return constellation, labels, energy_before, energy_after


# ==============================================================
# 3. GENERATE SQUARE M-QAM CONSTELLATION
# ==============================================================

def create_qam(M):

    side = int(np.sqrt(M))

    # Example:
    # 16-QAM -> [-3, -1, 1, 3]
    # 64-QAM -> [-7, -5, -3, -1, 1, 3, 5, 7]

    levels = np.arange(-(side - 1), side, 2)

    constellation = []
    labels = []

    bits_axis = int(np.log2(side))

    for q_index in range(side):

        for i_index in range(side):

            I = levels[i_index]
            Q = levels[q_index]

            constellation.append(I + 1j * Q)

            # Gray code separately on I and Q axes
            gray_I = binary_to_gray(i_index)
            gray_Q = binary_to_gray(q_index)

            label = (gray_Q << bits_axis) | gray_I

            labels.append(label)

    constellation = np.array(constellation, dtype=complex)
    labels = np.array(labels)

    # Mandatory validation:
    # energy before normalization
    energy_before = np.mean(np.abs(constellation) ** 2)

    # Normalize average symbol energy to 1
    constellation /= np.sqrt(energy_before)

    energy_after = np.mean(np.abs(constellation) ** 2)

    return constellation, labels, energy_before, energy_after


# ==============================================================
# 4. GET CONSTELLATION
# ==============================================================

def get_constellation(name):

    if name == "QPSK":
        return create_psk(4)

    elif name == "8-PSK":
        return create_psk(8)

    elif name == "16-QAM":
        return create_qam(16)

    elif name == "64-QAM":
        return create_qam(64)

    else:
        raise ValueError("Unknown modulation")


# ==============================================================
# 5. INTEGER TO BITS
# ==============================================================

def integers_to_bits(values, bits_per_symbol):

    values = np.asarray(values)

    bit_matrix = (
        (values[:, None] >>
         np.arange(bits_per_symbol - 1, -1, -1))
        & 1
    )

    return bit_matrix.reshape(-1)


# ==============================================================
# 6. MAP RANDOM SYMBOL INDICES TO CONSTELLATION
# ==============================================================

def modulate(symbol_indices, constellation):

    return constellation[symbol_indices]


# ==============================================================
# 7. MINIMUM-DISTANCE DETECTOR
# ==============================================================

def detect(received, constellation):

    # Euclidean distance:
    #
    # d = |r - s_i|^2

    distance = np.abs(
        received[:, None] - constellation[None, :]
    ) ** 2

    detected_indices = np.argmin(distance, axis=1)

    return detected_indices


# ==============================================================
# 8. ADD AWGN
# ==============================================================

def add_awgn(symbols, EbN0_dB, bits_per_symbol):

    EbN0 = 10 ** (EbN0_dB / 10)

    # Es = 1
    # Eb = Es/k
    #
    # N0 = Eb / (Eb/N0)

    N0 = 1 / (bits_per_symbol * EbN0)

    noise_sigma = np.sqrt(N0 / 2)

    noise = noise_sigma * (
        np.random.randn(len(symbols)) +
        1j * np.random.randn(len(symbols))
    )

    return symbols + noise


# ==============================================================
# 9. CALCULATE BER AND SER
# ==============================================================

def simulate_errors(name, EbN0_dB, Nsymbols=30000):

    constellation, labels, _, _ = get_constellation(name)

    M = len(constellation)

    bits_per_symbol = int(np.log2(M))

    # Generate random symbol locations
    tx_indices = np.random.randint(0, M, Nsymbols)

    tx_symbols = modulate(tx_indices, constellation)

    # Add AWGN
    rx_symbols = add_awgn(
        tx_symbols,
        EbN0_dB,
        bits_per_symbol
    )

    # Minimum-distance detection
    rx_indices = detect(
        rx_symbols,
        constellation
    )

    # ----------------------------------------------------------
    # SER
    # ----------------------------------------------------------

    SER = np.mean(tx_indices != rx_indices)

    # ----------------------------------------------------------
    # BER using Gray labels
    # ----------------------------------------------------------

    tx_labels = labels[tx_indices]
    rx_labels = labels[rx_indices]

    tx_bits = integers_to_bits(
        tx_labels,
        bits_per_symbol
    )

    rx_bits = integers_to_bits(
        rx_labels,
        bits_per_symbol
    )

    BER = np.mean(tx_bits != rx_bits)

    return BER, SER


# ==============================================================
# 10. PRINT ENERGY NORMALIZATION RESULTS
# ==============================================================

modulations = [
    "QPSK",
    "8-PSK",
    "16-QAM",
    "64-QAM"
]

print("\n================================================")
print("AVERAGE CONSTELLATION ENERGY VALIDATION")
print("================================================")

for name in modulations:

    constellation, labels, E_before, E_after = \
        get_constellation(name)

    print("\n", name)

    print("Average energy before normalization =",
