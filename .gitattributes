    plt.semilogy(
        EbN0_dB,
        BER_plot,
        marker="o",
        label=name
    )

plt.title(
    "BER Performance of M-PSK and M-QAM"
)

plt.xlabel(
    "$E_b/N_0$ (dB)"
)

plt.ylabel(
    "Bit Error Rate (BER)"
)

plt.grid(
    True,
    which="both"
)

plt.legend()
plt.tight_layout()
plt.show()


