# ==============================================================
# 11. IDEAL AND RECEIVED CONSTELLATIONS
# ==============================================================

# Required SNR values from experiment
snr_values_constellation = [0, 5, 10, 20]

for name in modulations:

    constellation, labels, _, _ = \
        get_constellation(name)

    M = len(constellation)

    k = int(np.log2(M))

    Ndisplay = 1000

    tx_indices = np.random.randint(
        0,
        M,
        Ndisplay
    )

    tx_symbols = constellation[tx_indices]

    # ----------------------------------------------------------
    # IDEAL CONSTELLATION
    # ----------------------------------------------------------

    plt.figure(figsize=(6, 6))

    plt.scatter(
        constellation.real,
        constellation.imag,
        s=100
    )

    for i in range(M):

        plt.text(
            constellation[i].real + 0.03,
            constellation[i].imag + 0.03,
            format(labels[i], f"0{k}b")
        )

    plt.axhline(0)
    plt.axvline(0)

    plt.title(
        f"Ideal Constellation - {name}"
    )

    plt.xlabel("In-phase (I)")
    plt.ylabel("Quadrature (Q)")
    plt.grid(True)
    plt.axis("equal")
    plt.tight_layout()
    plt.show()

    # ----------------------------------------------------------
    # RECEIVED CONSTELLATIONS AT 0, 5, 10, 20 dB
    # ----------------------------------------------------------

    for snr in snr_values_constellation:

        received = add_awgn(
            tx_symbols,
            snr,
            k
        )

        plt.figure(figsize=(6, 6))

        plt.scatter(
            received.real,
            received.imag,
            s=10,
            alpha=0.4,
            label="Received"
        )

        plt.scatter(
            constellation.real,
            constellation.imag,
            s=100,
            marker="x",
            label="Ideal"
        )

        plt.axhline(0)
        plt.axvline(0)

        plt.title(
            f"{name} Received Constellation "
            f"at Eb/N0 = {snr} dB"
        )

        plt.xlabel("In-phase (I)")
        plt.ylabel("Quadrature (Q)")

        plt.legend()
        plt.grid(True)
        plt.axis("equal")
        plt.tight_layout()
        plt.show()


# ==============================================================
# 12. DECISION REGIONS
# ==============================================================

for name in modulations:

    constellation, labels, _, _ = \
        get_constellation(name)

    M = len(constellation)

    # Determine plotting boundary
    limit = (
        max(
            np.max(np.abs(constellation.real)),
            np.max(np.abs(constellation.imag))
        )
        + 0.6
    )

    # Grid for decision regions
    x = np.linspace(
        -limit,
        limit,
        350
    )

    y = np.linspace(
        -limit,
        limit,
        350
    )

    X, Y = np.meshgrid(x, y)

    grid_points = (
        X.ravel() +
        1j * Y.ravel()
    )

    decisions = detect(
        grid_points,
        constellation
    )

    Z = decisions.reshape(X.shape)

    plt.figure(figsize=(7, 6))

    plt.contourf(
        X,
        Y,
        Z,
        levels=np.arange(M + 1) - 0.5,
        alpha=0.35
    )

    plt.scatter(
        constellation.real,
        constellation.imag,
        s=100,
        marker="x"
    )

    plt.axhline(0)
    plt.axvline(0)

    plt.title(
        f"Decision Regions - {name}"
    )

    plt.xlabel("In-phase (I)")
    plt.ylabel("Quadrature (Q)")

    plt.grid(True)
    plt.axis("equal")
    plt.tight_layout()
    plt.show()


