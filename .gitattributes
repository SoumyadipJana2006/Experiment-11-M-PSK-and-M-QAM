# ==============================================================
# 17. BER VERSUS SPECTRAL EFFICIENCY
# ==============================================================

# For ideal uncoded modulation:
#
# Spectral efficiency approximately = log2(M) bits/s/Hz

spectral_efficiency = {
    "QPSK": 2,
    "8-PSK": 3,
    "16-QAM": 4,
    "64-QAM": 6
}


# Choose one Eb/N0 value for comparison
target_snr = 10

index = np.where(
    EbN0_dB == target_snr
)[0][0]

efficiency_values = []

ber_values = []

labels_plot = []

for name in modulations:

    efficiency_values.append(
        spectral_efficiency[name]
    )

    ber_values.append(
        max(
            BER_results[name][index],
            1e-6
        )
    )

    labels_plot.append(name)


plt.figure(figsize=(8, 6))

plt.semilogy(
    efficiency_values,
    ber_values,
    "o-",
    markersize=8
)

for x_point, y_point, label in zip(
    efficiency_values,
    ber_values,
    labels_plot
):

    plt.annotate(
        label,
        (x_point, y_point),
        xytext=(5, 5),
        textcoords="offset points"
    )

plt.title(
    f"BER vs Spectral Efficiency "
    f"at Eb/N0 = {target_snr} dB"
)

plt.xlabel(
    "Spectral Efficiency (bits/s/Hz)"
)

plt.ylabel(
    "Bit Error Rate (BER)"
)

plt.grid(
    True,
    which="both"
)

plt.tight_layout()
plt.show()


